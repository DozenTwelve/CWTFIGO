#!/bin/sh
# cw: the only way CWTFIGO runs scripts and keeps the record. Runs on the operator machine. POSIX sh.
#
#   cw name <name>                   name (or rename) this machine in the record: the SSH alias other machines use for it
#   cw run <alias> <script> [args]   run a script on <alias> ("local" = this machine), only if approved
#   cw approve <alias> <script>...   the human said yes: store each script's current hash (all or none); <script>@<sha256 start> as run prints it
#   cw approve <alias> probes        the human said yes to every read-only probe the plugin ships (not smart, not host scripts)
#   cw yolo [<alias>|off]            the human said so: unapproved scripts (on every machine, or <alias>) run and get approved, 12 h
#   cw mode [strict|normal]          how much Claude Code asks on this machine: every step, or only changes and new scripts
#   cw save "<message>"              commit the record, push if it has a remote
#   cw join <ssh-alias>:<path>       share the record other operator machines keep there (any git URL or path)
#   cw status                        welcome panel: what this is, which machines the record knows
#   cw hermes [<dir>]                one Hermes skill per approved menu script (the TUI's), into <dir> (~/.local/share/cwtfigo/hermes)
#   cw search [-n N] <words...>      what the record's own past cases (and a locally built archive of public bug threads, if any) say about these symptoms or error strings
#   cw miss [--host <alias>] [--upstream <owner/repo|url>] <words...>   log a search whose hits didn't fit; where the answer was
#   cw tui                           install or update the TUI (~/.local/bin/cwtfigo) to this plugin's version, Mac and Linux
#
# <alias>: the SSH alias, also the host's dir in hosts/. "local", or this machine's own name ($REC/self), runs here.
# A record not shared with other computers (no remote) names this machine from its hostname on the first "local".
# <script>: collect | check | maintain | hosts/<alias>/<name>.sh, else scripts/probes/<name>.sh. .ps1 on Windows.
# A missing check.sh / maintain.sh is copied from foundations/<os>/ (os from device.json); run and approve refuse it
# until the model has adapted it and deleted its CWTFIGO-FOUNDATION line. Unapproved scripts print (the plugin's own: header and path) and exit 3 (under yolo: print and run).
# collect writes hosts/<alias>/facts.md and exits 4 if the machine id no longer matches or another host has it.

SKILL=$(cd "$(dirname "$0")/.." && pwd)
REC=${CWTFIGO_HOME:-$HOME/.cwtfigo}
# This plugin's version: cw tui installs that TUI, cw save writes it into every commit as a cw-version: trailer.
PJ="$SKILL/../../.claude-plugin/plugin.json"
VERSION=$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$PJ" 2>/dev/null)

die() { echo "cw: $*" >&2; exit 1; }
sha() { if command -v sha256sum >/dev/null; then sha256sum "$1"; else shasum -a 256 "$1"; fi | cut -d' ' -f1; }
git_rec() { git -C "$REC" "$@"; }
# Every ssh cw runs: a dead link or a hung machine drops within a minute. No overall timeout: maintain --apply can be long.
SSHO='-o ServerAliveInterval=15 -o ServerAliveCountMax=4'
ssh() { command ssh $SSHO "$@"; }
remote() { [ -n "$(git_rec remote 2>/dev/null)" ]; }
# No git identity on a fresh machine: fall back to one, never over the user's own. Used unquoted: no spaces in it.
ident() { git_rec config user.email >/dev/null || { git_rec config user.name >/dev/null || printf '%s ' -c user.name=cwtfigo; printf '%s ' -c user.email=cwtfigo@localhost; }; }
# On Windows python3 is often the Microsoft Store stub: it exists but runs nothing.
pyfind() { for py in python3 python ''; do [ -n "$py" ] && "$py" -c '' 2>/dev/null && break; done; [ -n "$py" ]; }

# macOS without the Command Line Tools: /usr/bin/git and python3 are stubs that pop an install dialog and fail.
[ "$(uname -s)" = Darwin ] && ! xcode-select -p >/dev/null 2>&1 &&
  die "this Mac needs the Command Line Tools (git, python3) first: run xcode-select --install, then try again"
# Approvals are hashes: without a tool to make them, every approval line would be empty and match every script.
command -v sha256sum >/dev/null || command -v shasum >/dev/null || die "this machine has neither sha256sum nor shasum, which cw needs to check approvals: install coreutils (or perl, for shasum), then try again"

# The TUI of exactly this plugin's version (never "latest": a TUI newer or older than its cw may not fit it), from the
# release tui-release.yml builds for its tag. Before the record: it reads and writes nothing there.
if [ "$1" = tui ]; then
  os=$(uname -s); m=$(uname -m)
  case $os in Darwin|Linux) ;; MINGW*|MSYS*|CYGWIN*) die "the TUI is for Mac and Linux only, there's no Windows build" ;; *) die "the TUI is for Mac and Linux only, there's no build for $os" ;; esac
  # The builds tui-release.yml makes: anything else would 404 and read like a login problem.
  case $os-$m in Darwin-arm64|Darwin-x86_64|Linux-x86_64|Linux-aarch64) ;; *) die "there's no TUI build for this processor ($m): only 64-bit Intel/AMD and 64-bit ARM" ;; esac
  v=$VERSION; [ -n "$v" ] || die "no version in $PJ"
  command -v curl >/dev/null || die "the TUI downloads with curl, which this computer doesn't have: install it (Debian/Ubuntu/Mint: sudo apt install curl; Fedora: sudo dnf install curl; Arch: sudo pacman -S curl; a Mac has it), then try again"
  tag=tui-v$v; a=cwtfigo-tui-$os-$m.tar.gz; B=$HOME/.local/bin; u=https://github.com/DozenTwelve/CWTFIGO/releases/download/$tag/$a
  # A clone's own build, linked there (tui/README): replacing the link would cut it off from later rebuilds.
  [ -L "$B/cwtfigo" ] && die "~/.local/bin/cwtfigo is a link to your own build, $(readlink "$B/cwtfigo"): nothing installed. Rebuild it instead (git pull, then cargo build --release in tui/)"
  mkdir -p "$B" || die "cannot create $B"
  # The new binary is written next to the old one and renamed over it: one filesystem, so the swap is atomic and a
  # running TUI keeps its old file.
  n=$B/.cwtfigo.$$; T=$(mktemp -d) || die "no temp dir"
  trap 'rm -rf "${T:?}"; rm -f "$n"' EXIT; trap 'exit 1' INT TERM HUP
  # Right after a plugin update its TUI is still building (a few minutes), and GitHub caches the 404 a while longer.
  # Only a 404 says so; anything else is the connection. The timeouts end a stalled one (the TUI's u waits on this).
  get() { c=$(curl -fsSL --connect-timeout 15 --max-time 300 -w '%{http_code}' -o "$1" "$2") && return
    [ "$c" = 404 ] && die "the TUI for $v isn't ready to download yet: after a plugin update it takes a few minutes to build. Try again in 5 minutes (in the TUI: u)"
    die "couldn't reach GitHub to download the TUI (curl's error is above): check the connection to github.com, then try again"; }
  get "$T/$a" "$u"; get "$T/$a.sha256" "$u.sha256"
  read -r s _ < "$T/$a.sha256"
  [ -n "$s" ] && [ "$(sha "$T/$a")" = "$s" ] || die "$a doesn't match its .sha256: nothing installed"
  tar -xzf "$T/$a" -C "$T" cwtfigo && cp "$T/cwtfigo" "$n" && chmod +x "$n" && mv -f "$n" "$B/cwtfigo" || die "cannot install $a into $B"
  echo "cwtfigo $v installed in ~/.local/bin"
  # The rc file of the owner's shell; a Mac's bash reads .bash_profile in a new terminal, Linux's .bashrc.
  case ${SHELL##*/} in
    zsh) add="add export PATH=\"\$HOME/.local/bin:\$PATH\" to ~/.zshrc" ;;
    bash) [ "$os" = Darwin ] && rc=.bash_profile || rc=.bashrc; add="add export PATH=\"\$HOME/.local/bin:\$PATH\" to ~/$rc" ;;
    fish) add="run fish_add_path ~/.local/bin" ;;
    *) add="add export PATH=\"\$HOME/.local/bin:\$PATH\" to ~/.profile" ;;
  esac
  case :$PATH: in
    *":$B:"*) c=$(command -v cwtfigo); [ "$c" = "$B/cwtfigo" ] || echo "another cwtfigo comes first on PATH, $c: remove it or move ~/.local/bin before it" ;;
    *) echo "~/.local/bin isn't on PATH: $add, then open a new terminal" ;;
  esac
  exit 0
fi
# Without git, git init below would fail as "cannot create $REC", which reads like a permissions problem.
command -v git >/dev/null || die "CWTFIGO keeps its notes in git: install it (Debian/Ubuntu/Mint: sudo apt install git; Fedora: sudo dnf install git; Arch: sudo pacman -S git; Mac: xcode-select --install), then try again"
[ -d "$REC/.git" ] || { mkdir -p "$REC" && git init -q "$REC"; } || die "cannot create $REC"
ignores() {
  # Scripts in the record are piped to targets and approved by hash: a Windows operator's autocrlf must not add .
  # self names this operator machine and differs per machine, and so does mode (how much Claude Code asks); yolo.on is
  # a switch with a 12 h life; archive/ is a local build artifact. None of them reaches git.
  # Files every operator only appends to merge as a union: two saves that each added lines are no conflict.
  for l in '* text=auto eol=lf' 'misses.jsonl merge=union' 'hosts/*/approved.sha256 merge=union' 'hosts/*/cases.jsonl merge=union'; do
    grep -qsxF "$l" "$REC/.gitattributes" || echo "$l" >> "$REC/.gitattributes"; done
  for l in self mode yolo.on 'hosts/*/yolo.on' archive/; do grep -qsxF "$l" "$REC/.gitignore" || echo "$l" >> "$REC/.gitignore"; done
}
ignores
SELF=$(cat "$REC/self" 2>/dev/null)
NONAME="this computer has no name in the notes yet. Ask the owner what to call it: the short name their other computers use to reach it, if they have one (the Host line in their ~/.ssh/config), then: cw name <name>"

# Record layout version. Bump it with every layout change and add the step that upgrades the old one.
SCHEMA=2
have=$(cat "$REC/schema" 2>/dev/null || echo 0)
[ "$have" -gt $SCHEMA ] && die "the record is schema $have, this plugin knows $SCHEMA. Update the plugin (another operator machine wrote it)."
[ "$have" = $SCHEMA ] || echo $SCHEMA > "$REC/schema"

# One operator machine (the record isn't shared): name it after its hostname, nobody reaches it by an alias. Its hosts
# so far may all be remote ones. Shared with other operators, and they know hosts: they may know it by an alias, ask.
autoname() {
  remote && for d in "$REC"/hosts/*/; do [ -d "$d" ] && die "$NONAME"; done
  # A Mac's LocalHostName, else uname -n (POSIX: stock Arch has no hostname command) up to its domain: MacBook-Air.local is macbook-air.
  n=; [ "$(uname -s)" = Darwin ] && n=$(scutil --get LocalHostName 2>/dev/null)
  [ -n "$n" ] || n=$(uname -n 2>/dev/null)
  n=$(printf %s "${n%%.*}" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9-')
  case $n in ''|local) die "$NONAME" ;; esac
  # Another machine's dir: this one would run with its approvals.
  [ -e "$REC/hosts/$n" ] && die "another computer in the notes is already called $n. $NONAME"
  setname "$n"; echo "cw: this machine is called $n in the record. Another name? cw name <name>" >&2
}

# This machine's dir follows its name: hosts/<the name self holds now> becomes hosts/<the new one>.
setname() {
  old=$SELF
  if [ -n "$old" ] && [ "$old" != "$1" ] && [ -d "$REC/hosts/$old" ]; then
    [ -e "$REC/hosts/$1" ] && die "both hosts/$old and hosts/$1 exist: merge them by hand into hosts/$1, then cw name $1"
    if git_rec ls-files --error-unmatch "hosts/$old" >/dev/null 2>&1; then git_rec mv "hosts/$old" "hosts/$1"
    else mv "$REC/hosts/$old" "$REC/hosts/$1"; fi || die "cannot rename hosts/$old"
  fi
  echo "$1" > "$REC/self" && echo $SCHEMA > "$REC/schema" || die "cannot write $REC/self"
  SELF=$1
}

# A machine's name is a dir under hosts/ and an ssh argument: no path (\ is one on Windows), no option, no space,
# no glob (* ? [ would match other hosts in the git pathspecs of join and setname).
badname() { case $1 in ''|.|..|-*|*/*|*\\*|*[[:space:]]*|*[[*?]*) return 0 ;; esac; return 1; }

# alias: the host's name in the record (its dir). here: run on this machine, no SSH.
host() {
  badname "$1" && die "bad <alias> '$1': the SSH alias, no / \\ * ? [ or spaces, not starting with -"
  if [ "$1" = local ] || [ "$1" = "$SELF" ]; then
    [ -n "$SELF" ] || autoname
    here=1; alias=$SELF
  else
    here=; alias=$1
  fi
  H="$REC/hosts/$alias"
}
# The host's dir, made only once something is written there (an approval, facts, a switch): a run that stops before
# (unreachable, not approved yet, a no at the prompt) leaves no machine row behind, and a new record stays new.
mkh() { [ -d "$H" ] || { mkdir -p "$H" && touch "$H/approved.sha256" "$H/log.md"; } || die "cannot create $H"; }

# A name cw puts into a path under the plugin (an os, a probe): [a-z0-9_-] only. device.json and .origin come from the
# shared record, which another operator machine (or anything that writes there) may have filled.
word() { case $1 in ''|*[!a-z0-9_-]*) return 1 ;; esac; }

# First check/maintain for a host: copy this OS's foundation. The model adapts it before approval.
foundation() {
  os=$(sed -n 's/.*"os": *"\([^"]*\)".*/\1/p' "$H/device.json" 2>/dev/null)
  [ -n "$os" ] || die "no os in $H/device.json: collect and write device.json first"
  word "$os" || die "bad os '$os' in $H/device.json: an os-release ID like arch or debian, only a-z 0-9 _ -"
  # A Debian derivative without its own starts from debian's: same apt, dpkg, systemd. A list, not os-release's ID_LIKE:
  # nothing more for the model to write into device.json, and no base whose foundation wouldn't fit (manjaro's arch).
  b=$os; [ -d "$SKILL/foundations/$os" ] || case $os in ubuntu|raspbian|linuxmint|pop|elementary|zorin|kali) b=debian ;; esac
  [ -f "$SKILL/foundations/$b/$1.$X" ] || die "no $os foundation for $1.$X: write $F for this host from its record"
  cp "$SKILL/foundations/$b/$1.$X" "$F"
  echo "$(sha "$F")  foundations/$b/$1.$X" > "$F.origin"  # which foundation, for cw status once a plugin update fixes it
}

# Windows targets run PowerShell, not sh: SSH into Windows lands in cmd or PowerShell. device.json decides once it
# exists; before that (first collect), local asks uname and remote asks the shell, which only Windows expands to Windows_NT.
windows() {
  [ -f "$H/device.json" ] && { grep -q '"os": *"windows"' "$H/device.json"; return; }
  if [ -n "$here" ]; then case $(uname -s) in MINGW*|MSYS*|CYGWIN*) return 0 ;; esac; return 1; fi
  # Asked before anything is approved, on every first run: never a password prompt, never a hang on a dead host.
  # Unreachable is not "not Windows": a password-only host would get sh scripts piped into PowerShell.
  # ssh's own last line says which: off or away (timed out), no such name (resolve), no key login (Permission denied).
  wo=$(ssh -o BatchMode=yes -o ConnectTimeout=10 "$alias" 'echo %OS%$env:OS' 2>&1)
  [ $? = 255 ] && { l=$(printf '%s\n' "$wo" | tail -1); die "can't reach $alias over ssh without a prompt (down, not in ~/.ssh/config, or password-only: cw needs a key login).${l:+ ssh said: $l} Try: ssh $alias"; }
  case $wo in *Windows_NT*) return 0 ;; esac; return 1
}

# The read-only probes the plugin ships; tests/cw.sh keeps this equal to scripts/probes/. Only these and collect
# are plug(in) scripts: shown by header and path, and approved by cw approve probes. A file written into probes/
# later is shown in full and approved by name, like any other.
PROBES=" apps.sh boot.sh dns.sh docker.sh env.ps1 health.ps1 health.sh hw.sh link.sh logs.ps1 logs.sh net.ps1 net.sh perf.sh running.sh sleep.sh smart.sh space.ps1 space.sh wifi.sh "
# A listed probe by name. Only a word: a file named "apps.sh boot.sh" would match two entries of the list at once.
probe() { word "$1" && case $PROBES in *" $1.$X "*) ;; *) false ;; esac; }

resolve() {
  windows && X=ps1 || X=sh
  case /$1/ in *[/\\]..[/\\]*) die "no .. in a script name or path: $1" ;; esac
  plug=
  case $1 in
    collect) F="$SKILL/scripts/collect.$X"; plug=1 ;;
    check|maintain) F="$H/$1.$X"; [ -f "$F" ] || foundation "$1" ;;
    # The host's own script wins over the probe of the same name: it was written for this machine.
    *) F="$H/$1.$X"
       [ -f "$F" ] || { F="$SKILL/scripts/probes/$1.$X"; probe "$1" && plug=1; }
       [ -f "$F" ] || { F=$1; plug=; } ;;
  esac
  [ -f "$F" ] || die "no such script: $1"
  # Only the host's own scripts and the plugin's: anything else (a bare name found in the shell's current dir, a key)
  # would be run, and under YOLO approved, by a hash nobody saw the file of.
  case $F in "$H"/*|"$SKILL/scripts/collect.$X"|"$SKILL"/scripts/probes/*) ;;
    *) die "$1 isn't one of $alias's own scripts ($H) or the plugin's: cw runs only those. Write it into $H first, then run it by its name" ;; esac
}

# PowerShell loader, base64 UTF-16LE so no shell in between can mangle it. stdin: the number of args, one arg per line
# (as data, never parsed: an arg with a space arrives whole, one with $( or ' runs nothing), the script, then
# a #CWTFIGO-END line: over SSH into a PowerShell default shell, stdin's EOF sometimes never arrives, so it reads up to
# the marker instead of to EOF. It runs the script as a function, so the execution policy doesn't apply (the script
# was approved by hash), dot-sourced, so $script: and the script's own top level are one scope, as in a .ps1 file.
# Its output goes through an Out-Default ended in finally: an exit in the script would drop a table still in the formatter.
# Started by -Command, not -EncodedCommand: with that, 5.1 writes errors and Write-Host to stderr as #< CLIXML. Over
# SSH it goes in double quotes, which cmd and PowerShell both pass on as one word. Plain text:
# $ProgressPreference='SilentlyContinue'; [Console]::OutputEncoding=[Text.Encoding]::UTF8; $n=[int][Console]::In.ReadLine(); $cwArgs=@(for ($i=0; $i -lt $n; $i++) { [Console]::In.ReadLine() }); $b=New-Object Text.StringBuilder; while ((($x=[Console]::In.ReadLine()) -ne $null) -and ($x -ne '#CWTFIGO-END')) { [void]$b.AppendLine($x) }; Set-Item function:cw $b.ToString(); Remove-Variable n,i,x,b; $cwOut={ Out-Default }.GetSteppablePipeline(); $cwOut.Begin($true); try { . cw @cwArgs | ForEach-Object { $cwOut.Process($_) } } finally { $cwOut.End() }

PSRUN="iex([Text.Encoding]::Unicode.GetString([Convert]::FromBase64String('$PSLOAD')))"

# Args for sh, quoted: each one in '', ' as '\''. They go in a "set --" line ahead of the script, never into ssh's
# command: that is parsed by the target's login shell, and fish reads \' inside '' as an escape (x\'; echo PWN #).
q() { for a; do printf "'%s' " "$(printf %s "$a" | sed "s/'/'\\\\''/g")"; done; }

# The caller can die (a timed-out tool, a closed terminal) and signal cw alone: ssh would run on, orphaned, until the
# script on the target ends. So ssh runs in the background and goes down with cw; exec, so $! is ssh itself, not the
# subshell the ssh function would run in. The run on the target is left to finish: sshd doesn't stop it (Windows
# neither, checked), and a half-done maintain --apply is worse.
sargs() { printf 'set -- %s\n' "$(q "$@")"; cat "$F"; }
reap() { p=$!; trap 'kill $p 2>/dev/null; exit 1' INT TERM HUP; wait $p; }
# ssh exits 255 when it can't reach the machine or loses it: past the first collect nothing but ssh's own line said so.
gone() { [ "$1" = 255 ] && [ -z "$here" ] && echo "cw: can't reach $alias over ssh, or lost it (exit 255, ssh's error is above)" >&2; return "$1"; }

go() {
  # The PowerShell loader's ReadLine ends an arg at \r as well as \n: the rest would run as code. Refused on every
  # path, so an arg means the same on every OS.
  cr=$(printf '\r')
  for a; do case $a in *"$cr"*) die "an arg can't hold a carriage return" ;; esac; done
  if [ "$X" = ps1 ]; then
    for a; do case $a in *'
'*) die "an arg for a PowerShell script can't hold a newline" ;; esac; done
    # No tty path, cw doesn't elevate: admin steps run only if the session already is admin, else go to the human.
    # The echo after cat: a last line without a newline would swallow the marker.
    psin() { printf '%s\n' $# "$@"; cat "$F"; echo; echo '#CWTFIGO-END'; }
    if [ -n "$here" ]; then psin "$@" | powershell.exe -NoProfile -NonInteractive -Command "$PSRUN"
    else psin "$@" | exec ssh $SSHO "$alias" powershell -NoProfile -NonInteractive -Command "\"$PSRUN\"" & reap; fi
  elif [ -n "$here" ]; then
    sh "$F" "$@"
  elif [ -t 0 ]; then
    # Human at a terminal (sudo may prompt): copy over, run with a tty, remove.
    # Its command only sh -c with the temp path in '': the same in sh, bash, zsh and fish.
    t=$(ssh "$alias" mktemp) && sargs "$@" | ssh "$alias" "cat > $t" && ssh -t "$alias" "sh -c 'sh $t; r=\$?; rm -f $t; exit \$r'"
  else
    sargs "$@" | exec ssh $SSHO "$alias" 'sh -s' & reap
  fi
}

# $1 then each block of $2 (a line and the indented lines under it, a bullet with its details) that $1 lacks.
union() {
  awk 'function out() { if (f == 1) seen[b]; else if (b != "" && !(b in seen)) printf "%s", b; b = "" }
       FNR == 1 { out(); f++ }
       f == 1 { print }
       /^$/ { out(); next }
       /^[^ \t]/ { out() }
       { b = b $0 "\n" }
       END { out() }' "$1" "$2"
}

# What cw save would commit, one path a line. An unadapted foundation never is (cw save leaves it out), and in a record
# with no commit yet neither are cw's own files.
unsaved() {
  c=$(git_rec rev-parse -q --verify HEAD)
  git_rec status --porcelain -uall | while read -r x p; do
    if [ "$x" = '??' ]; then
      grep -qs '^# CWTFIGO-FOUNDATION' "$REC/$p" && continue
      [ -z "$c" ] && case $p in (.gitattributes|.gitignore|schema) continue ;; esac
    fi
    echo "$p"
  done
}
approved() { h=$(sha "$F") && [ -n "$h" ] && grep -qs "^$h " "$H/approved.sha256"; }
unadapted() { ! grep -q '^# CWTFIGO-FOUNDATION' "$F" || die "$name on $alias is the unadapted foundation ($F): first adapt it to this machine from its record and delete the CWTFIGO-FOUNDATION line. Don't show it to the human or ask for approval before that."; }

# YOLO is on while $REC/yolo.on (every machine) or $H/yolo.on (one host) holds an epoch less than 12 h old.
# cw yolo off deletes them; a stale or garbled one is deleted here. cw save leaves them: one visit saves many times.
fresh() {
  [ -f "$1" ] || return 1
  t=$(cat "$1"); case $t in ''|*[!0-9]*) t=0 ;; esac
  # ponytail: fixed 12 h window, about a working day; per-visit token if a long-lived switch ever bites.
  # From the future (a clock set back, a hand-written epoch) it would never expire: not on.
  a=$(( $(date +%s) - t )); [ $a -ge 0 ] && [ $a -lt 43200 ] && return 0
  rm -f "$1"; return 1
}
yolo() { fresh "$REC/yolo.on" || fresh "$H/yolo.on"; }
# Strict unless there is no mode file or it says normal (any case, spaces aside): a garbled one fails closed, as in the hook.
strict() { [ -e "$REC/mode" ] && [ "$(tr -d ' \t\r\n' 2>/dev/null < "$REC/mode" | tr 'A-Z' 'a-z')" != normal ]; }

case $1 in
run)
  # Pull first: resolve may copy a foundation, and a copy made in a stale record sits untracked where the pull would
  # bring the other operator's adapted script. Every pull after that fails and the record forks.
  remote && { git_rec pull -q --ff-only --no-rebase || echo "cw: pull failed, using local record" >&2; }
  host "$2"; resolve "$3"; name=$3; unadapted; shift 3
  # A private copy is what gets hashed, shown and run: sh reads a script as it goes, so the file itself, rewritten
  # while it runs, would run code nobody approved. O stays the file, for git and for the human.
  O=$F; F=$(mktemp) && cp "$O" "$F" || die "cannot copy $O"
  trap 'rm -f "$F"' EXIT; trap 'exit 1' INT TERM HUP
  if ! approved; then
    grep -qs "  $name  " "$H/approved.sha256" && why="changed since it was last approved (plugin update or edit)" || why="never approved here"
    # The plugin's own collect and probes (plug, from resolve): their header says what they read, the rest stays at the path.
    if yolo; then
      y=1
      echo "YOLO: running unapproved $name on $alias, $why (sha256 $(sha "$F"))"
    else
      y=
      echo "NOT APPROVED: $name on $alias, $why (sha256 $(sha "$F"))"
      # name@<hash start>: approve refuses it if the file changed since this showed it.
      a="cw approve $alias $name@$(sha "$F" | cut -c1-12)"
      case $why$plug in never*|*1) echo "Tell the human in one line what it reads or changes, then run $a right away: the permission prompt they get is the question, don't also ask in chat and wait. About to run other scripts here that need approval too (a first visit's check and maintain)? Run them first, then approve all of them in that one call: one prompt" ;;
                        *) echo "Show the human what changed, then run $a right away: the permission prompt they get is the question, don't also ask in chat and wait. About to run other scripts here that need approval too (a first visit's check and maintain)? Run them first, then approve all of them in that one call: one prompt" ;; esac
    fi
    if git_rec ls-files --error-unmatch "$O" >/dev/null 2>&1 && ! git_rec diff --quiet HEAD -- "$O"; then
      git_rec --no-pager diff HEAD -- "$O"
    elif [ -n "$plug" ]; then
      awk 'NR == 1 && /^#!/ { next } !/^#/ { exit } { print }' "$F"; echo "full script: $O"
    else
      cat "$F"
    fi
    [ -n "$y" ] || exit 3
    mkh; echo "$(sha "$F")  $name  $(date +%F)  yolo" >> "$H/approved.sha256"
  fi
  [ "$name" = collect ] || { go "$@"; gone $?; exit $?; }
  out=$(mktemp); go > "$out"; rc=$?; cat "$out"; gone $rc
  if [ $rc = 0 ]; then
    old=$(grep -m1 '^id: ' "$H/facts.md" 2>/dev/null); new=$(grep -m1 '^id: ' "$out")
    if [ -n "$old" ] && [ "$old" != "$new" ]; then
      echo "cw: ID MISMATCH on $alias: record has '$old', machine says '$new'. Not saved. Ask the human." >&2
      rm -f "$out"; exit 4
    fi
    for f in "$REC"/hosts/*/facts.md; do
      [ "$f" != "$H/facts.md" ] && [ -n "$new" ] && [ "$(grep -m1 '^id: ' "$f" 2>/dev/null)" = "$new" ] || continue
      o=${f%/facts.md}; echo "cw: this machine is already in the record as ${o##*/}. Use that name (or rename one dir by hand)." >&2
      rm -f "$out"; exit 4
    done
    mkh; cp "$out" "$H/facts.md"
  fi
  rm -f "$out"; exit $rc ;;
approve)
  host "$2"
  if [ $# = 3 ] && [ "$3" = probes ]; then
    # Each plugin probe by its own hash, so an update to one asks again for that one. Left to ask one by one:
    # smart (sudo is its own floor), and a host script of the same name, which wins over the probe.
    windows && X=ps1 || X=sh; n=; mkh
    for F in "$SKILL"/scripts/probes/*.$X; do
      p=$(basename "$F" .$X)
      probe "$p" || continue
      [ "$p" != smart ] && [ ! -f "$H/$p.$X" ] || continue
      approved || echo "$(sha "$F")  $p  $(date +%F)" >> "$H/approved.sha256"; n="$n $p"
    done
    echo "approved on $alias:${n:- no read-only probes for this OS}"; exit 0
  fi
  [ $# -ge 3 ] || die "usage: cw approve <alias> <script>[@<sha256 start>] [<script>...] | cw approve <alias> probes"
  shift 2
  for name; do [ "$name" != probes ] || die "cw approve <alias> probes is a form of its own: not mixed with script names"; done
  # Several scripts, one prompt: all or nothing. Each is refused as it would be alone (its own error shows), and if any
  # is, none is approved. <script>@<sha256 start>, as cw run prints it: refused if the file changed since run showed it.
  bad=
  for a; do
    name=${a%@*}; w=${a#"$name"}; w=${w#@}
    ( resolve "$name"; unadapted
      [ -z "$w" ] || case $w in ????????*) case $(sha "$F") in "$w"*) ;; *) false ;; esac ;; *) false ;; esac ||
        die "$name changed since cw run showed it (or $w isn't the start of its sha256): run it again, so the human sees what they say yes to" ) || bad="$bad $name"
  done
  [ -z "$bad" ] || die "approved none: refused$bad"
  mkh; for a; do name=${a%@*}; resolve "$name"; approved || echo "$(sha "$F")  $name  $(date +%F)" >> "$H/approved.sha256"; done
  echo "approved: $* on $alias" ;;
name)
  { badname "$2" || [ "$2" = local ]; } && die "usage: cw name <name>: this machine's SSH alias as the other machines use it, not local, no / \\ * ? [ or spaces, not starting with -"
  setname "$2"
  echo "this machine is $2 in the record" ;;
join)
  [ $# = 2 ] && [ -n "$2" ] || die "usage: cw join <ssh-alias>:<path>: the shared record the other operator machines push to (any git URL or path)"
  o=$(git_rec remote get-url origin 2>/dev/null)
  [ -z "$o" ] || [ "$o" = "$2" ] || die "this record already shares with $o, not $2"
  # A record with no commit and only cw's own files is new: it takes the shared record as it is (a clone).
  start=$(git_rec rev-parse -q --verify HEAD)
  [ -z "$(unsaved)" ] || die "the record has unsaved changes: cw save \"<message>\" first, then cw join $2 again"
  # t is undo's temp dir, made further down: never one an environment variable named t points at.
  t=; added=; [ -n "$o" ] || { git_rec remote add origin "$2" && added=1; } || die "cannot add the remote $2"
  # Anything going wrong from here puts the record back where it was.
  undo() { git_rec merge --abort 2>/dev/null; [ -z "$start" ] || git_rec reset -q --hard "$start"; [ -z "$added" ] || git_rec remote remove origin
           rm -rf "$t"; die "$* Nothing changed."; }
  git_rec fetch -q origin || undo "cannot fetch $2, git's error is above."
  # Another computer's own record has its branch checked out, and git refuses every push into that: each cw save here
  # would fail. Only a shared copy (a bare repo) takes them. Asked where cw can: a path here, or <ssh-alias>:<path>.
  nb=
  if [ -d "$2" ]; then nb=$(git -C "$2" rev-parse --is-bare-repository 2>/dev/null)
  else case $2 in *://*) ;; *:*) a=${2%%:*}; p=${2#*:}
    badname "$a" || case $p in ''|*[!A-Za-z0-9._/~+-]*) ;; *)
      nb=$(command ssh -o BatchMode=yes -o ConnectTimeout=10 "$a" git -C "$p" rev-parse --is-bare-repository 2>/dev/null) ;; esac ;; esac
  fi
  [ "$nb" != false ] || undo "$2 is another computer's own notes, not a shared copy: git refuses to save into it, so every cw save here would fail. Make a shared copy on a computer that's always on (ssh <box> git init --bare cwtfigo.git), cw join <box>:cwtfigo.git and cw save on the computer those notes are on, then cw join <box>:cwtfigo.git here."
  # The shared record's only branch, whatever its name (a bare repo's HEAD may name one nobody pushed).
  b=$(git_rec for-each-ref --format='%(refname)' refs/remotes/origin/ | sed 's|^refs/remotes/origin/||' | grep -vx HEAD)
  case $b in
    '') echo "the shared record $2 is empty: the next cw save puts this record there"; exit 0 ;;
    *"
"*) undo "the shared record has several branches ($(echo $b)): join it by hand." ;;
  esac
  # Already one record (joined before): nothing to merge, a pull does the rest.
  if git_rec merge-base HEAD "origin/$b" >/dev/null 2>&1; then
    git_rec branch -q --set-upstream-to="origin/$b" || die "cannot set the upstream: git branch -u origin/$b"
    echo "already joined $2: cw status pulls what's new"; exit 0
  fi
  # A host the shared record knows by the same collector id, under any name: the shared one stays. Read by object id,
  # not <rev>:<path>, which Git Bash rewrites into a Windows path.
  ids=$(git_rec ls-tree -r "origin/$b" -- hosts | while read -r _ _ s p; do
    case $p in (hosts/*/facts.md) n=${p#hosts/}; printf '%s\t%s\n' "$(git_rec cat-file blob "$s" | grep -m1 '^id: ')" "${n%/facts.md}" ;; esac
  done)
  drop=; me=$SELF
  for f in "$REC"/hosts/*/facts.md; do
    id=$(grep -m1 '^id: ' "$f" 2>/dev/null) && [ -n "$id" ] || continue
    s=$(printf '%s\n' "$ids" | awk -F'\t' -v i="$id" '$1 == i { print $2; exit }'); [ -n "$s" ] || continue
    l=${f%/facts.md}; l=${l##*/}
    git_rec rm -rq -- "hosts/$l" >/dev/null || undo "cannot drop hosts/$l."
    [ "$l" != "$SELF" ] || me=$s
    echo "cw: hosts/$l is hosts/$s in the shared record: kept the shared one. This record's copy stays in git history: git -C $REC log -- hosts/$l" >&2
    drop="$drop $l"
  done
  [ -z "$drop" ] || git_rec $(ident) commit -qm "cw join: drop$drop, the shared record has these hosts" || undo "cannot commit."
  [ -n "$start" ] || rm -f "$REC/.gitattributes" "$REC/.gitignore" "$REC/schema"
  t=$(mktemp -d) || undo "no temp dir."
  # Not merged and no merge going on: git stopped before it began (an untracked file in the way, ...).
  git_rec $(ident) merge -q --no-commit --allow-unrelated-histories "origin/$b" >/dev/null 2>"$t/err" ||
    git_rec rev-parse -q --verify MERGE_HEAD >/dev/null || { cat "$t/err" >&2; undo "cannot merge $2, git's error is above."; }
  # Both sides have it: cw's own files come from the shared record; the notes every operator grows at the root are the
  # shared file plus this record's blocks it lacks. Anything else stops the join.
  c=
  for f in $(git_rec diff --name-only --diff-filter=U); do
    case $f in
      .gitignore|.gitattributes|schema) git_rec checkout -q --theirs -- "$f" ;;
      operator.md|topology.md|misses.jsonl) git_rec checkout -q --theirs -- "$f" && cp "$REC/$f" "$t/s" && git_rec checkout -q --ours -- "$f" &&
        cp "$REC/$f" "$t/o" && union "$t/s" "$t/o" > "$t/u" && mv "$t/u" "$REC/$f" ;;
      *) c="$c $f"; continue ;;
    esac && git_rec add -- "$f" || undo "cannot merge $f."
  done
  rm -rf "$t"
  [ -z "$c" ] || undo "both records have their own$c: merge by hand, or delete this record's copy, cw save, and cw join again."
  ignores; git_rec add .gitattributes .gitignore || undo "cannot add .gitignore."
  if git_rec rev-parse -q --verify MERGE_HEAD >/dev/null; then git_rec $(ident) commit -qm "cw join: merge the shared record $2" || undo "cannot commit the merge."
  else git_rec diff --cached --quiet || git_rec $(ident) commit -qm "cw join: .gitignore" || undo "cannot commit."; fi
  git_rec branch -q -M "$b" && git_rec branch -q --set-upstream-to="origin/$b" || die "joined, but cannot set the upstream: git branch -u origin/$b"
  [ "$me" = "$SELF" ] || { echo "$me" > "$REC/self"; SELF=$me; echo "cw: this machine is $me in the record now" >&2; }
  echo "joined $2: one record now.$([ "$(git_rec rev-parse HEAD)" = "$(git_rec rev-parse "origin/$b")" ] || echo ' The next cw save shares this machine'"'"'s part.')"
  [ -n "$SELF" ] || echo "hint: $NONAME" >&2 ;;
mode)
  # How much Claude Code asks on this operator machine, read by hooks/approve-gate.sh: strict, or normal (the default).
  # The hook asks the human before a cw mode that sets one.
  case $#$2 in
    1) strict && echo strict || echo normal ;;
    2strict|2normal) echo "$2" > "$REC/mode" || die "cannot write $REC/mode"; echo "mode: $2" ;;
    *) die "usage: cw mode [strict|normal]" ;;
  esac ;;
yolo)
  case $2 in
  off) rm -f "$REC/yolo.on" "$REC"/hosts/*/yolo.on; echo "YOLO off: unapproved scripts stop and ask again." ;;
  '') date +%s > "$REC/yolo.on"; echo "YOLO on for every machine for 12 h, or until cw yolo off: unapproved scripts run without asking." ;;
  *) host "$2"; mkh; date +%s > "$H/yolo.on"; echo "YOLO on for $alias for 12 h, or until cw yolo off: unapproved scripts run without asking." ;;
  esac ;;
status)
  remote && { git_rec pull -q --ff-only --no-rebase || echo "cw: pull failed, using local record" >&2; }
  # One promise, true in every mode: a script runs once approved, and a change (--apply) asks each time. Under YOLO
  # the first half isn't: say so, for which machines, and the hours left of its 12 (fresh leaves the epoch in t).
  yw=; yh=0
  for f in "$REC/yolo.on" "$REC"/hosts/*/yolo.on; do
    fresh "$f" || continue
    d=${f%/yolo.on}; [ "$f" = "$REC/yolo.on" ] && d="every machine" || d=${d##*/}; yw="${yw:+$yw, }$d"
    l=$(( (43200 - $(date +%s) + t + 3599) / 3600 )); [ $l -gt $yh ] && yh=$l
  done
  # A first-ever visit, known by the record, not guessed: no host, no commit, no remote. The TUI matches this prefix.
  set -- "$REC"/hosts/*/
  [ ! -d "$1" ] && ! remote && ! git_rec rev-parse -q --verify HEAD >/dev/null && new=1 || new=
  # Every visit opens with the mascot, its last line the promise (under YOLO its own line says it).
  cat <<'EOF'
       *
       |
  .----'----.
  |  _   _/ |    CWTFIGO
  | (-o)(-o)|    Claude, what the fuck is going on?
  | [#####] |
EOF
  if [ -n "$yw" ]; then echo "  '---------'"; else echo "  '---------'    Scripts run only after your OK."; fi
  echo
  [ -z "$yw" ] || echo "  YOLO is on for $yw, up to $yh h left: new scripts run without your OK. Anything that changes a computer still asks every time."
  r=$REC; case $r in "$HOME"/*) r="~${r#"$HOME"}" ;; esac
  echo "  Notes stay on your side: $r$(remote && echo ' and your private remote')"
  echo "  CWTFIGO version: ${VERSION:-unknown}"  # bug reports ask for it
  # Another operator machine on a newer plugin (the highest cw-version: trailer of the last 50 commits): probes approved
  # there have other hashes, so this one is asked again for no visible reason. Compared as numbers: 0.5.10 > 0.5.9.
  nv=$(git_rec log -n 50 --format=%B 2>/dev/null | awk -v me="$VERSION" '
    function gt(a, b,  x, y, n, m, i) { n = split(a, x, "."); m = split(b, y, "."); if (m > n) n = m
      for (i = 1; i <= n; i++) if (x[i] + 0 != y[i] + 0) return x[i] + 0 > y[i] + 0
      return 0 }
    /^cw-version: [0-9]+(\.[0-9]+)*$/ { v = substr($0, 13); if (me != "" && gt(v, me) && (top == "" || gt(v, top))) top = v }
    END { print top }')
  [ -z "$nv" ] || echo "  Another computer uses CWTFIGO $nv, this one $VERSION. Update this one: claude plugin marketplace update cwtfigo && claude plugin update cwtfigo@cwtfigo, then restart Claude Code."
  # stdout is the human's, shown as is; hint: lines on stderr are the model's.
  if [ -n "$new" ]; then
    # One line, nothing to remember: other computers come up only when the owner brings them up.
    echo "hint: this record is new and not shared: this owner is new to CWTFIGO. A problem they named comes first. If they only said the name, offer a checkup of this computer in plain words: you'd look at its OS and hardware, disk, memory and battery health, failed services, pending updates and how much space cleaning would free (sizes only, never what's in their files), and nothing changes until they say so. Joining another computer's notes comes up only if they mention one where they used CWTFIGO: see Remote and several machines (it takes a shared copy on a computer that's always on)." >&2
  fi
  # Changed by hand and never saved (a script deleted, a note edited): other operator machines go on seeing the old one.
  # Not .gitignore/.gitattributes: after an update cw adds its own lines there (ignores), and those aren't the owner's.
  n=$(unsaved | grep -cvxE '\.git(ignore|attributes)')
  [ "$n" = 0 ] || echo "hint: the record has unsaved changes (files: $n, e.g. a file deleted by hand; git -C $REC status shows them): once you know what they are, cw save \"<what changed>\"." >&2
  # A host copy whose foundation changed since (a plugin update fixed it): the fixes don't reach the copy by themselves.
  # A copy from before .origin existed says nothing. Nor does a plugin older than another computer's (the update line
  # above): its foundations may be the older ones, and carrying those over would undo the other's fixes.
  [ -n "$nv" ] || for o in "$REC"/hosts/*/*.origin; do
    [ -f "$o" ] && read -r s p < "$o" || continue
    # Only a foundation: anything else would have cw hash it and tell the model to carry it into a host script.
    case $p in foundations/*/check.sh|foundations/*/check.ps1|foundations/*/maintain.sh|foundations/*/maintain.ps1) b=${p#*/}; word "${b%/*}" ;; *) false ;; esac || continue
    # A copy not adapted yet is the plugin's text still: nothing of this machine's to carry fixes into.
    [ -f "${o%.origin}" ] && ! grep -q '^# CWTFIGO-FOUNDATION' "${o%.origin}" && [ -f "$SKILL/$p" ] && [ "$(sha "$SKILL/$p")" != "$s" ] || continue
    d=${o%/*}
    echo "hint: $SKILL/$p changed since ${o%.origin} was copied from it for ${d##*/}. Diff the two (the copy also differs by its adaptation to this machine: carry over only the foundation's fixes that apply; it needs the human's approval again), then write the line \"$(sha "$SKILL/$p")  $p\" to $o." >&2
  done
  echo
  set -- "$REC"/hosts/*/; [ -d "$1" ] && n=1 || n=0
  # One tab-separated row per machine; awk pads each column to its widest value, so long versions don't push rows apart.
  for d do
    [ -d "$d" ] || continue
    os=$(sed -n 's/.*"os": *"\([^"]*\)".*/\1/p' "$d/device.json" 2>/dev/null)
    ver=$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$d/device.json" 2>/dev/null)
    last=$(sed -n '/^## [0-9-]* unattended$/d; s/^## \([0-9-]*\).*/\1/p' "$d/log.md" 2>/dev/null | head -1)  # unattended runs aren't visits
    # Issues are top-level bullets under a "## Open ..." or "## Parked" heading; a "- (none)" placeholder is not one.
    issues=$(awk '/^## /{o = /[Oo]pen/; p = /[Pp]arked/; next} /^- *\(?none\)? *$/{next} /^- /{c += o; q += p} END{printf "%d open", c; if (q) printf ", %d parked", q}' "$d/notes.md" 2>/dev/null)
    H=$d; yolo && y="  YOLO" || y=
    h=$(basename "$d"); [ "$h" = "$SELF" ] && h="$h (this machine)"
    printf '%s\t%s\t%s\t%s%s\n' "$h" "$os $ver" "${last:-never}" "${issues:-0 open}" "$y"
  done | awk -F '\t' '{h[NR] = $1; s[NR] = $2; l[NR] = $3; i[NR] = $4; if (length($1) > a) a = length($1); if (length($2) > b) b = length($2)}
    END {for (r = 1; r <= NR; r++) printf "  %-" a "s  %-" b "s  last visit %-10s  %s\n", h[r], s[r], l[r], i[r]}'
  [ $n = 0 ] || echo  # no rows: the blank line above already sets the last line apart
  if [ $n = 0 ]; then echo "  No machines yet. Tell me what's wrong with this one, or the SSH alias of another."
  elif [ -n "$SELF" ] && [ -d "$REC/hosts/$SELF" ]; then echo "  Another machine? Tell me its SSH alias."
  else echo "  Another machine? Tell me its SSH alias, or ask about this one."; fi ;;
hermes)
  # The awk below re-implements tui/src/header.rs parse and main.rs items(): a change to either is made in both.
  # The TUI's menu (tui/src/main.rs items, header.rs parse) as Hermes skills, for an always-on box where Hermes runs
  # them without Claude Code (unattended/README.md): check, maintain and each script with a # menu: line, approved at
  # its current hash. Rebuilt whole each time, so a script removed or changed since approval loses its skill. Reads the
  # record only: no pull, no ssh, no approval.
  D=${2:-${XDG_DATA_HOME:-$HOME/.local/share}/cwtfigo/hermes}
  # No trailing /: mktemp -d "$D.XXXXXX" would land inside D, and the swap below would fail every run.
  D=${D%"${D##*[!/]}"}; [ -n "$D" ] || die "cw hermes needs a dir of its own, not /"
  [ ! -d "$D" ] || [ -e "$D/.cwtfigo-generated" ] || [ -z "$(ls -A "$D")" ] || die "$D has files cw hermes didn't make: nothing written. Give another dir: cw hermes <dir>"
  mkdir -p "$(dirname "$D")" && T=$(mktemp -d "$D.XXXXXX") && touch "$T/.cwtfigo-generated" || die "cannot write next to $D"
  trap 'rm -rf "$T" "$T.old"' EXIT; trap 'exit 1' INT TERM HUP
  for d in "$REC"/hosts/*/; do
    [ -d "$d" ] || continue
    H=${d%/}; alias=${H##*/}; here=; [ "$alias" = "$SELF" ] && here=1
    # The extension run would pick, without its ssh: another machine before its first collect gets both, as in the TUI.
    if [ -f "$H/device.json" ] || [ -n "$here" ]; then windows && X=ps1 || X=sh; else X='sh ps1'; fi
    for x in $X; do for F in "$H"/*."$x"; do
      [ -f "$F" ] && approved || continue
      name=$(basename "$F" ".$x")
      # Hermes' skill names: [a-z0-9._-], 64 at most; its slash commands keep only [a-z0-9-], Discord their first 32.
      n=$(printf 'cw-%s-%s' "$alias" "$name" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-' - | tr -s - | cut -c1-64 | sed 's/-$//')
      [ ! -e "$T/cwtfigo/$n" ] || { echo "cw: skipped $alias/$name.$x: its skill name $n is taken" >&2; continue; }
      # Bytes, not characters: the BOM is three of them, and a label in any language passes through as it is.
      s=$(N=$n A=$alias S=$name E=$x SH=$h REC=$REC CW="$SKILL/scripts/cw" LC_ALL=C awk -v q="'" -v bom="$(printf '\357\273\277')" '
        function trim(x) { sub(/^[ \t]+/, "", x); sub(/[ \t]+$/, "", x); return x }
        function yq(x) { gsub(q, q q, x); return q x q }
        # A part of the command line in single quotes unless it is plain: a path with a space runs as it reads. A quote
        # in it ends the quotes, adds one escaped and starts them again: joined by hand, awks differ on \ in gsub.
        function sq(x,  p, k, i, o) { if (x ~ /^[A-Za-z0-9._\/-]+$/) return x
          k = split(x, p, q); o = p[1]; for (i = 2; i <= k; i++) o = o q "\\" q q p[i]; return q o q }
        NR == 1 { h = 1; if (index($0, bom) == 1) $0 = substr($0, 4) }
        { sub(/\r$/, ""); l = trim($0) }
        l !~ /^#/ { h = 0; x = $0; gsub(/"/, "", x); gsub(q, "", x)
          if (index(x, "= --apply") || index(x, "--apply)") || index(x, "-contains --apply")) ap = 1; next }
        h && l !~ /^#!/ { c = l; sub(/^#+/, "", c); t = trim(c)
          if (t ~ /^menu-args:/) { g = ""; k = split(substr(t, 11), p, "|")
            for (i = 1; i <= k; i++) if ((y = trim(p[i])) != "") g = g (g == "" ? "" : " | ") y }
          else if (t ~ /^menu:/) { m = 1; lb = trim(substr(t, 6)) }
          # The header as the owner and earlier visits wrote it.
          else { if (ab == "" && t != "") ab = t; sub(/^ /, "", c); if (w != "" || t != "") w = w c "\n" } }
        END { if (!m && ENVIRON["S"] != "check" && ENVIRON["S"] != "maintain") exit
          a = ENVIRON["A"]; sc = ENVIRON["S"]; f = a "/" sc "." ENVIRON["E"]; if (!m) lb = (ab != "" ? ab : sc)
          sub(/\n+$/, "", w); r = "sh " sq(ENVIRON["CW"]) " run " sq(a) " " sq(sc); v = (g != "" ? " " q "<choice>" q : "")
          print "---"; print "name: " ENVIRON["N"]
          print "description: " yq(lb " (" sc " on " a ", the owner" q "s own CWTFIGO script). Use when the owner asks for this on " a ", or names " sc ".")
          print "version: " yq("sha256-" substr(ENVIRON["SH"], 1, 12))
          print "author: " yq("generated by cw hermes from " f ", overwritten on its next run")
          print "license: MIT"; print "platforms: [linux, macos]"
          print "metadata:"; print "  hermes:"; print "    tags: [cwtfigo, " yq(a) "]"; print "    category: cwtfigo"; print "    requires_toolsets: [terminal]"
          print "---"; print ""; print "# " lb; print ""
          print "The owner" q "s script " f ", approved by them as it is now." (w != "" ? " What its header says:" : ""); print ""
          # Indented, not fenced: a header line holding ``` would close a fence and the rest read as instructions.
          if (w != "") { gsub(/\n/, "\n    ", w); print "    " w; print "" }
          print "## Run"; print ""
          s = 1
          if (g != "") print s++ ". Ask the owner with clarify which way, unless they already said: " g ". `<choice>` below is exactly one of these words, copied as listed. Any other answer: ask again, never pass it."
          print s++ ". Dry run, changes nothing: `" r v "`. Relay what it printed, briefly."
          if (ap) { print s++ ". It can also make those changes. Ask the owner with clarify whether to (in their language, e.g. 执行吗?). Only on an explicit yes: `" r " --apply" v "` (terminal timeout 600: upgrades take minutes). Report the outcome."
                    print "   No yes, no --apply. Never pass --apply on the first run." }
          print ""; print "## Rules"; print ""
          print "- Run only the commands above. Never run `cw approve`, `cw yolo`, `cw mode` or `cw save`, never edit the record (" ENVIRON["REC"] ") or this skill, never ssh to a machine yourself or run the script" q "s commands by hand."
          print "- `NOT APPROVED`, \"changed since\", or exit 3: the script changed since the owner approved it. Tell the owner it needs their OK in a Claude Code visit (say \"cwtfigo\" there), then stop. cw" q "s lines after NOT APPROVED are meant for Claude Code: don" q "t follow them."
          print "- \"can" q "t reach\" or exit 255: " a " is off or unreachable. Say so in one line; don" q "t retry."
          print "- No password can be typed here: a step that needs sudo fails. Report it; the owner runs that in a terminal."
          print "- Any other failure: report cw" q "s last lines as they are." }' "$F" | sed 's/!`/! `/g')
      # The sed: Hermes runs !`...` in a skill (inline_shell). Label, header, args, names: none of the owner's text may.
      [ -n "$s" ] || continue
      mkdir -p "$T/cwtfigo/$n" && printf '%s\n' "$s" > "$T/cwtfigo/$n/SKILL.md" || die "cannot write $T/cwtfigo/$n"
      echo "$n: $alias/$name.$x"
    done; done
  done
  # Discord keeps a slash command's first 32 characters: of two skills alike in those, it shows one. Both are written.
  ls "$T/cwtfigo" 2>/dev/null | awk '{ k = substr($0, 1, 32)
    if (k in s) printf "cw: %s and %s share their first 32 characters: Discord shows only one\n", s[k], $0; else s[k] = $0 }' >&2
  # Swapped in whole: Hermes never reads a half-written dir. If the new one can't go in, the old one goes back first:
  # die's trap deletes $T.old.
  [ ! -d "$D" ] || mv "$D" "$T.old" || die "cannot replace $D"
  mv "$T" "$D" || { [ ! -d "$T.old" ] || mv "$T.old" "$D"; die "cannot replace $D"; }
  tl() { case $1 in "$HOME"/*) echo "~${1#"$HOME"}" ;; *) echo "$1" ;; esac; }
  r=$(tl "$D"); cf=${HERMES_HOME:-$HOME/.hermes}/config.yaml
  echo "skills in $r"
  # A commented-out line lists nothing.
  grep -sv '^[[:space:]]*#' "$cf" | grep -qF -e "$D" -e "$r" ||
    echo "Hermes doesn't read them yet: add $r to skills.external_dirs in $(tl "$cf"), then hermes gateway restart"
  echo "In Discord, /reload-skills picks up what changed." ;;
search)
  shift
  pyfind || die "search needs python3 on this machine"
  CWTFIGO_ARCHIVE=${CWTFIGO_ARCHIVE:-$REC/archive/archive.jsonl}
  # Own cases (hosts/*/cases.jsonl) are searched too, with or without a locally built archive.
  CWTFIGO_ARCHIVE=$CWTFIGO_ARCHIVE CWTFIGO_HOME=$REC exec "$py" -I "$SKILL/scripts/search.py" "$@" ;;
miss)
  # Hits that didn't fit this machine. No hit is logged by search.py itself. Read with jq.
  shift; mh=; up=; u="usage: cw miss [--host <alias>] [--upstream <owner/repo|url>] <query words...>"
  while :; do case $1 in
    --host) [ $# -ge 2 ] || die "$u"; mh=$2; shift 2 ;;
    --upstream) [ $# -ge 2 ] || die "$u"; up=$2; shift 2 ;;
    *) break ;;
  esac; done
  [ $# -gt 0 ] || die "$u"
  pyfind || die "miss needs python3 on this machine"
  "$py" -I -c 'import datetime, json, sys
print(json.dumps({"date": datetime.date.today().isoformat(), "query": " ".join(sys.argv[3:]),
                  "reason": "not relevant", "upstream": sys.argv[1], "host": sys.argv[2]}))' "$up" "$mh" "$@" \
    >> "$REC/misses.jsonl" || die "cannot write $REC/misses.jsonl"
  echo "miss logged in $REC/misses.jsonl" ;;
save)
  [ -n "$2" ] || die "missing message"
  m=$2
  git_rec add -A || die "commit failed"
  # Finishing a merge cw save stopped in: not while a file still holds its conflict lines, they'd be shared as they are.
  git_rec rev-parse -q --verify MERGE_HEAD >/dev/null && for f in $(git_rec diff --cached --name-only); do
    grep -qs '^<<<<<<< ' "$REC/$f" && die "$f still has the merge's <<<<<<< lines: fix them first, then cw save again"
  done
  # An unadapted foundation is the plugin's copy, not this machine's: it stays out of the record until adapted.
  for f in "$REC"/hosts/*/*; do grep -qs '^# CWTFIGO-FOUNDATION' "$f" && { git_rec reset -q -- "$f" || die "commit failed"; }; done
  # Which plugin wrote it: cw status on another operator machine sees when its own plugin is older.
  vt=${VERSION:+cw-version: $VERSION}
  { git_rec diff --cached --quiet || git_rec $(ident) commit -qm "$m" ${vt:+-m "$vt"}; } || die "commit failed"
  # A record that just got its remote has no upstream yet: the first push sets it.
  pf="push failed, git's error is above. The commit is saved here."
  if ! remote; then :
  elif ! git_rec rev-parse -q --verify '@{upstream}' >/dev/null 2>&1; then git_rec push -q -u "$(git_rec remote | head -1)" HEAD || die "$pf"
  elif ! git_rec push -q 2>/dev/null; then
    # Rejected, most likely because another operator pushed since this record's last pull: merge theirs and push once
    # more. A merge, never a rebase or a force: what is already shared stays as it is.
    git_rec fetch -q || die "$pf"
    if ! git_rec $(ident) merge -q --no-edit -m "cw save: merge the shared record" ${vt:+-m "$vt"} '@{upstream}' >/dev/null; then
      git_rec rev-parse -q --verify MERGE_HEAD >/dev/null || die "the push was rejected and the shared record can't be merged in, git's error is above. The commit is saved here."
      die "the shared record changed the same lines as this one: $(git_rec diff --name-only --diff-filter=U | tr '\n' ' ')
The merge is left in $REC. In each of those files keep what both sides need and delete the <<<<<<< ======= >>>>>>> lines, then: cw save \"$m\"
To drop the merge instead: git -C $REC merge --abort (this machine's commit stays here, not shared)."
    fi
    git_rec push -q || die "$pf"
  fi
  echo "saved" ;;
*)
  # The usage is this header, up to its first empty line.
  [ -z "$1" ] || echo "cw: unknown command: $1" >&2
  sed -n '2,/^$/p' "$0" | cut -c3-; exit 1 ;;
esac
